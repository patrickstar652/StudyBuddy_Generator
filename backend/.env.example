# Copy this file to backend/.env and replace placeholders with real secrets.
# Use the pooled Neon connection string (hostname contains `-pooler`).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Existing documents must be re-uploaded if this model is changed.
EMBEDDING_MODEL=shibing624/text2vec-base-chinese

FLASK_DEBUG=false
PORT=5001
